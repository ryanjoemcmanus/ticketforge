# Copy to .env for a production-like local run. Never commit real values.
DB_URL=jdbc:postgresql://postgres:5432/ticketforge
DB_USERNAME=ticketforge
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_URL=https://your-future-domain.example
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Keep safe adapters until test credentials are intentionally configured.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOTIFICATION_PROVIDER=log
MAIL_HEALTH_ENABLED=false
MAIL_FROM=noreply@your-future-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

DEMO_DATA=false
EXPOSE_DEVELOPMENT_TOKENS=false
